# Alertmanager config template, rendered by entrypoint.sh (spec 7 §5).
# Alertmanager does no env expansion and chat_id must be an integer, so the
# entrypoint substitutes the @...@ markers and picks the receiver block.
global:
  resolve_timeout: 5m

route:
  receiver: default
  group_by: [alertname, job]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: [job]

templates:
  - /etc/alertmanager/telegram.tmpl

receivers:
@RECEIVER@
