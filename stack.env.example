# Template for Portainer stacks deployed via the Repository build method
# (see docs/deploy-portainer.md). Portainer loads a stack.env found in the
# deployment repository as the stack's environment — unlike Web-editor
# stacks, it does NOT auto-create one from UI-entered variables.
#
# Copy to stack.env and fill in real values. NEVER commit a real
# stack.env to this public repo — it holds every database password.
# This repo deploys via Repository mode from a PRIVATE fork/mirror that
# carries the real stack.env, or via the Web editor (secrets stay in
# Portainer).

# --- Portainer / host paths -------------------------------------------------
# Where the JWT PEM files live on the Docker host (absolute path)
CERTS_DIR=/opt/meter-hub/certs
# Where the repo checkout with bind-mounted configs lives on the host
REPO_DIR=/opt/meter-hub/repo

# --- Postgres superuser -----------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=meterhub_admin
POSTGRES_PASSWORD=changeme

# --- Per-service databases (names/users as in .env.example) -----------------
IDENTITY_DB=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=changeme

HOUSEHOLD_DB=household_db
HOUSEHOLD_DB_USER=household_user
HOUSEHOLD_DB_PASSWORD=changeme

METER_DB=meter_db
METER_DB_USER=meter_user
METER_DB_PASSWORD=changeme

READING_DB=reading_db
READING_DB_USER=reading_user
READING_DB_PASSWORD=changeme

# --- Grafana admin (change from defaults) -----------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- JWT contract (defaults are fine; override only deliberately) -----------
IDENTITY_JWT_ISSUER=identity-service
IDENTITY_JWT_AUDIENCE=meterhub-api
