generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A meter reading recorded under a meter. The meter lives in Meter Service's
/// database, so meter_id is a plain UUID reference without a foreign key (no
/// cross-service DB access — PRD §6.4).
model Reading {
  id         String        @id @default(uuid()) @db.Uuid
  meterId    String        @map("meter_id") @db.Uuid
  value      Decimal       @db.Decimal(20, 6)
  recordedAt DateTime      @map("recorded_at") @db.Timestamptz(6)
  source     ReadingSource @default(MANUAL)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([meterId, recordedAt])
  @@map("readings")
}

enum ReadingSource {
  MANUAL

  @@map("reading_source")
}

/// Idempotency record for retried POST /readings submissions, shaped for
/// @nestjs/idempotency's IdempotencyStore contract (backlog A5). The table
/// is owned by PrismaIdempotencyStore's raw SQL — the model exists so the
/// schema and the client can type the rows it reads back. An in-flight lock
/// has an owner and no response; a completed record has a response and no
/// owner. Expired rows are treated as absent (takeover) — pruning is
/// opportunistic.
model IdempotencyKey {
  keyHash String @id @map("key_hash")
  key String
  fingerprint String
  owner String?
  response Json?
  expiresAt BigInt @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Transactional outbox for events produced by Reading Service (spec 5).
/// Written in the same transaction as the reading row; OutboxRelay
/// publishes and stamps published_at. id == the stable eventId consumers
/// dedup on. traceparent holds the creating request's W3C trace context.
model ReadingOutbox {
  id String @id @db.Uuid
  aggregateId String @map("aggregate_id") @db.Uuid
  eventType String @map("event_type")
  payload Json
  traceparent String? @map("traceparent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("reading_outbox")
}
