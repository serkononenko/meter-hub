.idea
.env
# Real Portainer stack environment (copy from stack.env) —
# must never land in this public repo
stack.env
.DS_Store

# Local development key material — never commit (dev-generated key pair; real
# environments deliver keys from a secret manager, not this repo)
/certs/

# Runtime data of the bind-mounted state directories (prod uses bind
# mounts under the repo checkout — see docker-compose.portainer.yml).
# Postgres/Grafana/Prometheus/Loki write here continuously.
/infrastructure/postgres/data/
/infrastructure/prometheus/data/
/infrastructure/grafana/data/
/infrastructure/loki/data/

# Playwright MCP session artifacts (snapshots, console logs, screenshots)
.playwright-mcp/
