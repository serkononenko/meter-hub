POSTGRES_DB=postgres
POSTGRES_USER=meterhub_admin
POSTGRES_PASSWORD=...

IDENTITY_DB=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=...

# The JWT contract (issuer/audience) is signed by identity-service and
# validated by api-gateway, so both containers must agree. It is defined once
# in docker-compose.yml (x-identity-jwt-env anchor) and defaults to these
# values — only set them here when overriding.
IDENTITY_JWT_ISSUER=identity-service
IDENTITY_JWT_AUDIENCE=meterhub-api

# JWT signing keys are NOT env vars — each environment delivers the two PEM
# files identity.jwt.private-key / identity.jwt.public-key (names are the
# config property names) to the app: locally in the shared repo-root certs/
# dir (each service reads it through a per-service `certs` symlink — create
# with: ln -sfn ../../certs certs), in containers/production as secret mounts
# at /run/secrets/.

# Gateway rate limiting (docs/service-boundaries.md §1). docker-compose.yml
# defaults to these values — only set them here when overriding. Limits are
# token buckets: capacity is the burst size, refill-tokens/refill-period the
# sustained rate. The auth bucket (login/register/refresh/logout, keyed by
# client IP) is intentionally tighter than the general bucket (keyed by
# access-token subject).
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_CAPACITY=60
#RATE_LIMIT_REFILL_TOKENS=30
#RATE_LIMIT_REFILL_PERIOD=1m
#RATE_LIMIT_AUTH_CAPACITY=10
#RATE_LIMIT_AUTH_REFILL_TOKENS=5
#RATE_LIMIT_AUTH_REFILL_PERIOD=1m

HOUSEHOLD_DB=household_db
HOUSEHOLD_DB_USER=household_user
HOUSEHOLD_DB_PASSWORD=...

METER_DB=meter_db
METER_DB_USER=meter_user
METER_DB_PASSWORD=...

READING_DB=reading_db
READING_DB_USER=reading_user
READING_DB_PASSWORD=...

# Grafana admin login (docker-compose.yml defaults to admin/admin when
# unset) — change before any environment other than local development.
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin